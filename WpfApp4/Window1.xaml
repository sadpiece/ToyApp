<Window x:Class="WpfApp4.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp4"
        mc:Ignorable="d"
        Title="AuthForm" Height="450" Width="800">
    <Border Background="#2D3748" Margin="10" Padding="20" CornerRadius="10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Авторизація" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="White" TextAlignment="Center"/>

            <TextBlock Text="Логін:" Margin="0,0,0,5" Foreground="White"/>
            <TextBox x:Name="TxtLogin" Margin="0,0,0,10" Padding="5" Background="#1A202C" Foreground="White"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" Foreground="White"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,20" Padding="5" Background="#1A202C" Foreground="White"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnLogin" Grid.Column="0" Content="Вхід" Padding="8" Background="#4299E1" Foreground="White" BorderThickness="0"  />
                <Button x:Name="BtnCancel" Grid.Column="2" Content="Скасувати" Padding="8" Background="#A0AEC0" Foreground="White" BorderThickness="0"  />
            </Grid>
        </StackPanel>
    </Border>
</Window>
